# OpenRouter key used for all model calls (server-side only)
OPENROUTER_API_KEY=

# Postgres connection string (Neon on Vercel). Leave unset locally to use the embedded PGlite database in .data/
DATABASE_URL=

# Vercel Cron sends this as a Bearer token; required in production
CRON_SECRET=

# Public site URL, used for canonical/OG metadata
APP_URL=http://localhost:3000

# Optional overrides
# SCORE_UPDATE_TIMEZONE=America/New_York
# EXTRACTION_MODEL=typesafe/jev-1.13
# INTERPRETATION_MODEL=openai/o4-mini
# FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
